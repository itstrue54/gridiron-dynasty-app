<?xml version="1.0" encoding="utf-8"?>
<!--
   What Android's own backup and phone-to-phone transfer may copy, on
   Android 12 and newer: only the dynasty saves and the app's settings, so a
   dynasty survives a new phone. backup_rules.xml says the same for older
   versions. The privacy policy says so (docs/play-store/privacy-policy.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
        <include domain="sharedpref" path="call_sheet.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
        <include domain="sharedpref" path="call_sheet.xml" />
    </device-transfer>
</data-extraction-rules>
